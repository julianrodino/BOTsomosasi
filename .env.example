# Copiá este archivo a .env y completá la clave.

# Claude (pago por uso): https://console.anthropic.com -> API keys
# Es el cerebro de Rita y también hace la búsqueda web (no hace falta otra clave).
ANTHROPIC_API_KEY=

# --- Opcionales (los valores de abajo son los por defecto) ---

# Modelo y cuánto "piensa" antes de hablar. low es lo más rápido al aire;
# medium o high si preferís respuestas más elaboradas a costa de latencia.
# RITA_MODELO=claude-opus-5-5
# RITA_ESFUERZO=low

# Cuántas búsquedas web puede hacer por respuesta.
# RITA_MAX_BUSQUEDAS=3

# Voz (edge-tts). Mujer argentina: es-AR-ElenaNeural. Hombre: es-AR-TomasNeural.
# Velocidad: "+0%" normal, "+8%" un toque más ágil para radio.
# RITA_VOZ=es-AR-ElenaNeural
# RITA_VELOCIDAD_VOZ=+8%

# Whisper local para entender lo que le dicen: tiny / base / small / medium / large-v3-turbo.
# small anda bien en castellano y es rápido en CPU. Se descarga a modelos/ la primera vez.
# RITA_WHISPER=small

# Micrófono: número o parte del nombre (ver `rita --dispositivos`). Vacío = el del sistema.
# RITA_MIC=

# Solo para `rita --auto`: cuánto ruido cuenta como voz. Bajalo (2%) si hablás bajo o Rita
# no te escucha; subilo (5%) si hay ruido de fondo y arranca sola.
# RITA_UMBRAL=3%
# Segundos de silencio que cortan la grabación en modo automático.
# RITA_SILENCIO=1.0

# Modo web (`rita --web`): código que pide la página para entrar. Si queda vacío se genera
# uno distinto en cada arranque y se imprime en la consola. Puerto del servidor.
# RITA_CODIGO=
# RITA_PUERTO=8765
